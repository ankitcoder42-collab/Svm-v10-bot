# SVM+ V11.3 — new keys (the installer adds these automatically; existing values are never overwritten)
PAYMENT_GATEWAYS=razorpay,upi          # razorpay | stripe | upi
DEFAULT_GATEWAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=               # events: payment_link.paid, payment.captured
RAZORPAY_ACCEPT_AUTHORIZED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                 # event: checkout.session.completed
STRIPE_CURRENCY=inr
STRIPE_AMOUNT_RATE=1.0
UPI_ENABLED=false
UPI_ID=
UPI_NAME=AnkitCoder
UPI_QR_URL=
SVM_PUBLIC_URL=https://pay.example.com # webhooks: /razorpay/webhook  /stripe/webhook
PAYMENT_WEBHOOK_HOST=127.0.0.1
PAYMENT_WEBHOOK_PORT=8787
PAYMENT_ADMIN_CHANNEL_ID=0
ORDER_TTL_MINUTES=60
UPI_ORDER_TTL_MINUTES=1440
MAX_PENDING_ORDERS=3
RENEW_DAYS=30
PLAN_PERIOD_DAYS=30
PLAN_STARTER_PRICE=0
PLAN_BASIC_PRICE=0
PLAN_STANDARD_PRICE=0
PLAN_PRO_PRICE=0
PORT_RANGE_START=20000
PORT_RANGE_END=50000
PORT_RESERVED=
PORT_MAX_PER_VPS=20
PORT_ALLOW_CUSTOM=false
IPAM_BIND_MODE=record                  # record | bridged | nat
IPAM_AUTO_ASSIGN=false
IPAM_HOST_IFACE=
IPAM_POOLS=                            # name|cidr|gateway|node_id;name2|cidr2
IPAM_POOL_MAX_ADDRS=4096
